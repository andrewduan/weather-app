{
  "name": "weather-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:server & npm run dev:frontend",
    "dev:server": "npm --prefix app/server run dev",
    "dev:frontend": "npm --prefix app/frontend run dev",
    "build": "npm --prefix app/frontend run build",
    "install:all": "npm --prefix app/server install && npm --prefix app/frontend install",
    "prettier": "prettier . --write"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
